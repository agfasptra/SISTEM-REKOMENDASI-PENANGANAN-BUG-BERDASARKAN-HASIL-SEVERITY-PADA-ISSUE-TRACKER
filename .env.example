# Salin file ini menjadi .env dan isi dengan nilai yang sesuai
# JANGAN pernah commit file .env ke repositori!

# Token Personal Access Token (PAT) GitHub Anda
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Daftar repositori target dalam format "owner/repo" (pisahkan dengan koma)
# Contoh: GITHUB_REPOS=microsoft/vscode,facebook/react,golang/go
GITHUB_REPOS=owner1/repo1,owner2/repo2

# (Opsional) Jumlah maksimum issue yang diambil per repositori (0 = semua)
MAX_ISSUES_PER_REPO=0

# (Opsional) Filter state issue: open, closed, atau all
ISSUE_STATE=all
